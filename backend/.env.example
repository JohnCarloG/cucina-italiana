# Aiven MySQL Database Configuration
# Copia questo file in .env e inserisci le tue credenziali
DATABASE_URL=mysql+pymysql://username:password@mysql-host.aivencloud.com:port/defaultdb?ssl_ca=path/to/ca.pem
JWT_SECRET=your-secret-key-minimum-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=30
REFRESH_TOKEN_EXP_DAYS=7
PRICE_SERVICE_FEE=1.5
